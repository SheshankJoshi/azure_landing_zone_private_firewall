{
  "pipeline": {
    "name": "ai-landing-zone",
    "identifier": "ai_landing_zone",
    "projectIdentifier": "ai_landing_zone",
    "orgIdentifier": "default",
    "stages": [
      {
        "stage": {
          "name": "Terraform",
          "identifier": "terraform",
          "type": "CI",
          "spec": {
            "execution": {
              "steps": [
                {
                  "step": {
                    "name": "terraform-init",
                    "identifier": "terraform_init",
                    "type": "Run",
                    "spec": {
                      "command": "terraform -chdir=terraform init -input=false"
                    }
                  }
                },
                {
                  "step": {
                    "name": "terraform-plan",
                    "identifier": "terraform_plan",
                    "type": "Run",
                    "spec": {
                      "command": "terraform -chdir=terraform plan -input=false -out=tfplan"
                    }
                  }
                },
                {
                  "step": {
                    "name": "terraform-apply",
                    "identifier": "terraform_apply",
                    "type": "Run",
                    "spec": {
                      "command": "terraform -chdir=terraform apply -input=false -auto-approve tfplan"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    ]
  }
}
